# ─── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Licences"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Base de données (MySQL) ───────────────────────────────────
DATABASE_URL="mysql://root:@127.0.0.1:3306/licences"

# ─── Secrets applicatifs (générer : npm run secrets) ───────────
# AUTH_SECRET : signature des codes de connexion (32 caractères min.)
AUTH_SECRET=""
# ENCRYPTION_KEY : chiffrement des accès livrés (32 octets en base64). NE JAMAIS LA PERDRE NI LA CHANGER.
ENCRYPTION_KEY=""
# CRON_SECRET : protège /api/cron/tick (24 caractères min.)
CRON_SECRET=""
# DISABLE_INTERNAL_SCHEDULER=1 : désactive la tâche planifiée interne (chaque minute) si un cron externe appelle /api/cron/tick.

# ─── Fournisseur : Flowseller ──────────────────────────────────
SUPPLIER_API_URL="https://flowseller-api.pe-supplykh.com/api/v1"
SUPPLIER_API_KEY=""

# ─── Paiement : pawaPay ─────────────────────────────────────────
PAWAPAY_API_URL="https://api.sandbox.pawapay.io/v2"
PAWAPAY_API_TOKEN=""

# ─── E-mail (SMTP) ─────────────────────────────────────────────
# Sans SMTP_HOST, les e-mails (dont les codes de connexion) s'affichent dans la console en développement.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Licences <no-reply@exemple.com>"
SUPPORT_EMAIL=""

# ─── Réseau ─────────────────────────────────────────────────────
# En-tête portant l'IP réelle du client, posé par VOTRE reverse proxy (qui doit l'écraser) : "x-real-ip" (nginx) ou
# "x-vercel-forwarded-for" (Vercel). Vide = non utilisé. Nombre de proxys de confiance devant l'application :
TRUSTED_IP_HEADER=""
TRUSTED_PROXY_HOPS=0
