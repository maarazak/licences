{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -c \"blue,green\" \"php artisan serve --port=8000\" \"npm run dev --prefix frontend -- -p 3001\"",
        "dev:laravel": "php artisan serve --port=8000",
        "dev:frontend": "npm run dev --prefix frontend -- -p 3001",
        "build": "vite build && npm run build --prefix frontend",
        "test": "npm test --prefix frontend"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
